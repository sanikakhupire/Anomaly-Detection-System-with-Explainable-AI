# Environment Configuration Template for Docker Compose and Production Deployment
# Copy this file to .env and adjust variables as necessary

# Backend Configuration
PORT=5000
NODE_ENV=production
MONGODB_URI=mongodb://mongo:27017/anomaly_detection
JWT_SECRET=change_this_to_a_secure_random_string_in_production
JWT_EXPIRES_IN=7d
ML_SERVICE_URL=http://ml-service:8000
FRONTEND_URL=http://localhost:3000
UPLOAD_DIR=/app/uploads
MAX_FILE_SIZE_MB=50

# Frontend Configuration
REACT_APP_API_URL=http://localhost:5000/api
REACT_APP_ENV=production

# ML Microservice Configuration
ML_PORT=8000
ML_HOST=0.0.0.0
